# Helios Demo Frontend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual configuration

# ⚠️  SECURITY WARNING: This template shows the required environment variables
# ⚠️  Replace placeholder values below with your actual backend configuration

# Development server configuration
HOST=localhost
PORT=3000

# Backend API URL Configuration
# For local development:
REACT_APP_BACKEND_URL=http://localhost:3001

# For production deployment:
# REACT_APP_BACKEND_URL=https://your-production-backend-url.com

# For staging/demo deployment:
# REACT_APP_BACKEND_URL=https://your-staging-backend-url.com

# Webpack development server security (for development only)
# Only enable this if you understand the security implications
# DANGEROUSLY_DISABLE_HOST_CHECK=true

# =====================================================
# DEPLOYMENT-SPECIFIC CONFIGURATIONS
# =====================================================

# AWS App Runner deployment:
# REACT_APP_BACKEND_URL=https://your-app-runner-url.us-east-1.awsapprunner.com

# AWS EC2 deployment:
# REACT_APP_BACKEND_URL=https://your-ec2-domain.com

# Docker deployment:
# REACT_APP_BACKEND_URL=http://localhost:3001

# Note: Never commit actual URLs or domains to version control.
# Use environment-specific values during deployment.
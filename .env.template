# Helios Engine Configuration Template
# Copy this file to .env and replace placeholder values with your actual API keys
# NEVER commit .env files containing real API keys to version control

# ⚠️  SECURITY WARNING: This template shows the required environment variables
# ⚠️  Replace ALL placeholder values below with your actual credentials

# Google Vertex AI Configuration (Required for main model)
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here
VERTEX_PROJECT_ID=your_vertex_project_id_here
VERTEX_LOCATION=us-central1

# Perplexity API Key (Required for research model)
# Get your API key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# OpenAI API Key (Required for fallback model)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Additional provider keys (not currently used but available)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# XAI_API_KEY=your_xai_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here
# MISTRAL_API_KEY=your_mistral_key_here
# AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# OLLAMA_API_KEY=your_ollama_key_here

# Optional Endpoint Overrides
# Use a specific provider's base URL, e.g., for an OpenAI-compatible API
# OPENAI_BASE_URL=https://api.third-party.com/v1

# Azure OpenAI Configuration (if using Azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# or
# AZURE_OPENAI_ENDPOINT=https://your-endpoint-name.cognitiveservices.azure.com/openai/deployments

# Ollama Configuration (if using local Ollama)
# OLLAMA_BASE_URL=http://custom-ollama-host:11434/api

# Note: The base URLs for Google Vertex AI, Perplexity, and OpenAI are already
# configured in .taskmaster/config.json and don't need to be set here unless
# you want to override them.